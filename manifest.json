{
  "manifest_version": 3,
  "name": "华工 SafeTest 自动答题",
  "version": "2.2.0",
  "description": "为华南理工大学实验室安全考试选择题库答案；永不自动交卷。",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://zhsys.sb.scut.edu.cn/*"
  ],
  "action": {
    "default_title": "华工 SafeTest 自动答题",
    "default_popup": "extension/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://zhsys.sb.scut.edu.cn/*"
      ],
      "js": ["extension/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["asset/questions.json"],
      "matches": [
        "https://zhsys.sb.scut.edu.cn/*"
      ]
    }
  ]
}
